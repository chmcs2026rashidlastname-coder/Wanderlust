<%layout("./layouts/boilerplate")%>

    <body>
        <h1>Edit page</h1>
        <div class="row mt-3">
            <div class="col-8 offset-2">
        <form method="post" action="/listings/edit/<%=list._id%>?_method=PUT" novalidate class="needs-validation">
            <div class="mb-2">
                <label for="title" class="form-label">Title:</label>
                <h3>Title:<input type="text" name="Listing[title]" value="<%=list.title%>" class="form-control">
                      <div class="valid-feedback">Good title</div>
        <div class="invalid-feedback">You have to enter the title!</div>
                </h3><br>
            </div>
            <div class="mb-2">
                <label for="description" class="form-label">Description:</label>
                <h4>Description:<input type="textarea" name="Listing[description]" value="<%=list.description%>"
                        class="form-control">
                    <div class="invalid-feedback">You can't leave textArea empty!*</div>
       </h4><br>
            </div>
            <div class="row">
            <div class="mb-2 col-md-4">
                <label for="price" class="form-label">Price:</label>
                <h4>Price:<input type="number" name="Listing[price]" value="<%=list.price%>" class="form-control">
                    <div class="invalid-feedback">You cannot leave the price empty* </div>
                </h4><br>
            </div>
            <div class="mb-2 col-md-8">
                <label for="location" class="form-label">Location:</label>
                <h4>Location:<input type="text" name="Listing[location]" value="<%=list.location%>"
                        class="form-control">
                    <div class="invalid-feedback">You have to type location*</div></h4><br>
            </div>
            </div>
            <div class="mb-2">
                <label for="country" class="label-form">Country:</label>
                <h4>Country:<input type="text" name="Listing[country]" value="<%=list.country%>"
                        class="form-control">
                    <div class="invalid-feedback">you have to enter the country name*</div></h4><br>
            </div>
            <div class="mb-2">
                <label for="image" class="form-label">Image:</label>
                <h4>Image:<input type="textarea" name="Listing[image.url]" value="<%=list.image.url%>"
                        class="form-control">
                    <div class="invalid-feedback">You cannot leave the image empty*</div></h4>
            </div>
            <button class="btn btn-dark edit-btn mt-3" value="submit">submit</button>

        </form>
        </div>
        </div>
    </body>