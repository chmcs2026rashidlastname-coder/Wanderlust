<%layout("./layouts/boilerplate")%>
<body>
    <div class="row">
        <div class="col-8 offset-2">
    <h1>CREATE NEW LISTINGS</h1>
    <form method="post" action="/listings/create" novalidate class="needs-validation" enctype="multipart/form-data">
       <div class="mb-3">
         <label for="title" class="form-label">Title</label>
        <input type="text" name="listing[title]" placeholder="title"  class="form-control" required>
        <div class="valid-feedback">Good title*</div>
        <div class="invalid-feedback">You have to enter the title!*</div>
       </div>
       <div class="mb-3">
        <label for="description" class="form-label">Description</label>
        <input type="text" name="listing[description]" placeholder="description" class="form-control" required>
          <div class="valid-feedback">Perfect Description*</div>
        <div class="invalid-feedback">You have to enter the Description!*</div>
       </div class=mb-3>
    <div class="mb-3">
           <label for="price" class="form-label">Price</label>
        <input type="number" name="listing[price]" placeholder="price" class="form-control" required>
          <div class="valid-feedback">Good Pricing*</div>
        <div class="invalid-feedback">You Have to give a pricing*</div>
    </div>
   <div class="mb-3">
     <label for="location" class="form-label">Location</label>
        <input type="text" name="listing[location]" placeholder="location" class="form-control" required>
          <div class="valid-feedback">Exact Location*</div>
        <div class="invalid-feedback">You have to enter the correct location*</div>
   </div>
  <div class="mb-3">
     <label for="country" class="form-label">Country</label>
        <input type="text" name="listing[country]" placeholder="country" class="form-control" required>
          <div class="valid-feedback">Peace*</div>
        <div class="invalid-feedback">You have to enter Your country name*</div>
  </div>
  <!-- <div class="mb-3">
    <label for="image" class="form-label">Image</label>
    <input type="text" name="listing[image][filename]" placeholder="image filename" class="form-control" required>
  </div> -->
  <div class="mb-3">
    <label for="image-url" class="form-label">Image URL</label>
    <input type="file" name="listing[image][url]" placeholder="image URL" class="form-control" required>
  </div>
  <div class="mb-3">
        <button value="Submit" class="btn btn-dark add-btn">Submit</button><br><br>
</div>
    </form>
    </div>
    </div>
    
</body>
